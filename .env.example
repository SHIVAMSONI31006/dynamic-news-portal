# ============================================================
# DYNAMIC NEWS PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Duplicate this file as .env in your root directory and adjust
# the values to match your deployment environment.
# DO NOT commit your production .env with sensitive passwords to Git.
# ============================================================

# Application Environment: 'development' | 'production' | 'staging'
APP_ENV=development

# Enable detailed error messages in development; set to false in production
APP_DEBUG=true

# Public Base URL of your deployed application (e.g. https://yournewsportal.example.com)
# Leave empty for automatic local directory resolution under XAMPP
APP_URL=

# If running a separate Admin CMS on another domain or port, set the public site domain here:
# PUBLIC_URL=https://yournewsportal.example.com

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_portal
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Timezone
APP_TIMEZONE=Asia/Kolkata
